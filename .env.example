# SentinelAI Environment Configuration Template

# Server & Network
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Security
SECRET_KEY=sentinel_ai_dev_secret_key_change_in_production_min_32_bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Persistence Layer
# Use PostgreSQL with pgvector in production, or SQLite for zero-config portable dev:
DATABASE_URL=sqlite:///./sentinelai.db
# DATABASE_URL=postgresql://sentinel_user:sentinel_pass@localhost:5432/sentinel_db
REDIS_URL=redis://localhost:6379/0

# Core Machine Learning & Risk Thresholds
XGBOOST_WEIGHT=0.70
ISOLATION_FOREST_WEIGHT=0.30
INITIAL_RISK_THRESHOLD=0.30
STEP_UP_OTP_THRESHOLD=0.30
HUMAN_REVIEW_THRESHOLD=0.70

# Multi-Agent Configuration
ENABLE_PARALLEL_AGENTS=true
AGENT_TIMEOUT_SECONDS=5.0
BEHAVIORAL_AGENT_WEIGHT=0.30
CONTEXT_AGENT_WEIGHT=0.25
RAG_AGENT_WEIGHT=0.25
SUMMARY_AGENT_WEIGHT=0.20

# OTP & Notification Service
OTP_EXPIRY_SECONDS=300
MOCK_OTP_MODE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fraud-alerts@sentinelai.bank

# Guardrails & Privacy
ENABLE_GUARDRAILS=true
ENABLE_PRESIDIO_PII_MASKING=true

# Evaluator Engine
EVALUATOR_MODEL=Qwen/Qwen2.5-1.5B-Instruct
EVALUATOR_FALLBACK_RULE_ENGINE=true
